# ──────────────────────────────────────────────
# CENTINELA TIC — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Database ───────────────────────────────────
POSTGRES_DB=centinela
POSTGRES_USER=centinela
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

DATABASE_URL=postgresql://centinela:CHANGE_ME_strong_password_here@localhost:5432/centinela

# ── Redis ──────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here
REDIS_URL=redis://:CHANGE_ME_redis_password_here@localhost:6379

# ── Application ────────────────────────────────
NODE_ENV=production
PORT=3001
BIND_HOST=127.0.0.1

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_byte_hex_secret

# AES-256 encryption key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_key

# ── Admin seed credentials ─────────────────────
# Used only on first startup to create the admin account.
# Remove after first login.
ADMIN_EMAIL=admin@centinela.local
ADMIN_PASSWORD=CHANGE_ME_initial_admin_password

# ── CORS ───────────────────────────────────────
# Frontend origin(s), comma-separated if multiple
CORS_ORIGIN=http://localhost:3000

# ── Frontend ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── Threat Intelligence (optional) ────────────
# Leave blank to run without VirusTotal (URLhaus still works)
VIRUSTOTAL_API_KEY=

# ── Scanner limits ─────────────────────────────
SCAN_TIMEOUT_SECONDS=30
MAX_EXTRACT_DEPTH=5
MAX_EXTRACT_SIZE_MB=200
MAX_EXTRACT_FILES=1000
UPLOAD_MAX_SIZE_MB=50
